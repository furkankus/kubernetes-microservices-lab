{
  "title": "Nginx Ingress Controller",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Total Requests",
      "targets": [
        {
          "expr": "sum(rate(nginx_ingress_controller_requests[1m]))"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Request Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nginx_ingress_controller_request_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "5xx Errors",
      "targets": [
        {
          "expr": "sum(rate(nginx_ingress_controller_requests{status=~\"5..\"}[1m]))"
        }
      ]
    }
  ],
  "schemaVersion": 37,
  "version": 1
}
